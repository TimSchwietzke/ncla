{
  "name": "ncla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NeetCodeLearnApp - personal preparation for technical interviews with the NeetCode 150",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:index && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "content:index": "tsx scripts/build-index.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "typecheck": "npm run content:index && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run content:validate && npm run test"
  },
  "dependencies": {

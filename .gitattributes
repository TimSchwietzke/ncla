# Normalise line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Binary-ish assets are never converted.
*.png binary
*.jpg binary
*.woff2 binary

# Lockfiles are committed on purpose (reproducible builds) but they are not
# authored code: collapse them in diffs and keep them out of language stats.
package-lock.json linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
